local function saveData()
    if writefile then
        pcall(function()
            local jsonString = HttpService:JSONEncode(savedSongs)
            writefile(SAVE_FILE_NAME, jsonString)
        end)
    end
end

local function loadData()
    if readfile and isfile and isfile(SAVE_FILE_NAME) then
        pcall(function()
            local content = readfile(SAVE_FILE_NAME)
            savedSongs = HttpService:JSONDecode(content)
        end)
    end
end

