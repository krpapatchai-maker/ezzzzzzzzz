local function registerSound(sound)
    if not sound:IsA("Sound") then return end

    if sound.IsPlaying or sound.TimePosition > 0 then
        createSoundCard(sound)
    end

    sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        if sound.IsPlaying then createSoundCard(sound) end
    end)

    sound:GetPropertyChangedSignal("TimePosition"):Connect(function()
        if sound.TimePosition > 0 and sound.IsPlaying then createSoundCard(sound) end
    end)

    sound:GetPropertyChangedSignal("SoundId"):Connect(function()
        if sound.IsPlaying then createSoundCard(sound) end
    end)
end

