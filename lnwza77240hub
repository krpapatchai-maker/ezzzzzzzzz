local function isValidSongId(rawText)
    local numStr = string.match(tostring(rawText), "%d+")
    if not numStr then return nil end
    if #numStr < MIN_ID_LENGTH then
        return nil 
    end
    return tonumber(numStr)
end

local function getRealSongName(soundObj, cleanId)
    if songNameCache[cleanId] ~= nil then
        return songNameCache[cleanId]
    end

    local songName = ""
    local success, assetInfo = pcall(function()
        return MarketplaceService:GetProductInfo(cleanId, Enum.InfoType.Asset)
    end)

    if success and assetInfo and assetInfo.Name then
        songName = assetInfo.Name
    else
        songName = soundObj and soundObj.Name or "Custom Song"
    end

    local lowerName = string.lower(songName)

    -- เพิ่มเงื่อนไขบล็อกชื่อ PowerWheels_Move (หรือถ้าชื่อมีคำนี้จะถูกบล็อกทันที)
    if string.find(lowerName, "powerwheels_move") then
        songNameCache[cleanId] = false
        return nil
    end

    for _, keyword in ipairs(SFX_KEYWORDS) do
        if string.find(lowerName, keyword) then
            songNameCache[cleanId] = false
            return nil
        end
    end

    if string.find(songName, "#####") then
        songNameCache[cleanId] = false
        return nil
    end

    if string.match(songName, "10%d*$") then
        songNameCache[cleanId] = false
        return nil
    end

    if string.find(lowerName, "e %s*%([%d]+%)") or string.find(lowerName, "e%s*%([%d]+%)") or lowerName == "e (1)" then
        songNameCache[cleanId] = false
        return nil
    end

    songNameCache[cleanId] = songName
    return songName
end

local function isSFX(soundObj)
    if not soundObj then return false end
    
    -- ถ้าชื่อ Sound ในเกมตรงกับ PowerWheels_Move ให้ถือว่าเป็นเสียงที่ต้องบล็อกทันที
    if soundObj.Name and string.lower(soundObj.Name) == "powerwheels_move" then
        return true
    end

    if not soundObj.IsLoaded and soundObj.TimeLength == 0 then
        task.wait(0.1)
    end
    if soundObj.TimeLength > 0 and soundObj.TimeLength < MIN_SONG_DURATION then
        return true
    end
    return false
end

