local function getPlayerFromSound(sound)
    local curr = sound.Parent
    while curr and curr ~= game do
        local player = Players:GetPlayerFromCharacter(curr)
        if player then return player end

        if curr:IsA("Backpack") and curr.Parent:IsA("Player") then
            return curr.Parent
        end

        if curr:IsA("Tool") or curr:IsA("Model") or curr:IsA("Accoutrement") then
            if curr.Parent then
                local p = Players:GetPlayerFromCharacter(curr.Parent)
                if p then return p end
            end
        end

        curr = curr.Parent
    end
    return nil
end

